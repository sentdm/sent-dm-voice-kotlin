#!/usr/bin/env bash
# Fails when Contract.kt is not what the pinned contract generates.
set -euo pipefail
cd "$(dirname "$0")/.."
f=voice-client-core/src/main/kotlin/dm/sent/voice/core/Contract.kt
python3 scripts/generate-contract.py >/dev/null
if ! git diff --quiet -- "$f"; then
  echo "Contract.kt is out of date with contract/voice-client.json; run scripts/generate-contract.py and commit." >&2
  git --no-pager diff -- "$f"
  exit 1
fi
echo "Contract.kt matches contract/voice-client.json $(python3 -c 'import json; print(json.load(open("contract/voice-client.json"))["version"])')"
